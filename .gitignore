yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Claude Code local state. The shared engineering context in .claude/ IS committed -
# it is how the team's agents, skills and hooks stay in sync - but anything ending in
# .local.json is per-developer and must not be.
.claude/settings.local.json
.claude/**/*.local.json
